# Copy to .env.local for local development (defaults below match `supabase start`'s
# well-known local demo keys — no need to change them for local dev).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
POSTGRES_URL=

# Route map tiles use OpenFreeMap (no key needed). Mapbox and MapTiler were
# both tried and dropped: MapTiler got stuck in an unresolved account state
# ("key usage restricted") for 24+ hours, and Mapbox requests were silently
# blocked before reaching Mapbox at all (reproduced across two networks with
# extensions disabled — likely a browser's built-in tracking protection, not
# fixable here). See src/components/route-map.tsx.

# Production values are provisioned automatically by the Supabase Vercel integration
# and injected at deploy time — never copy real production secrets into this file.
