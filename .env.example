# Copy to .env.local for local development (defaults below match `supabase start`'s
# well-known local demo keys — no need to change them for local dev).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
POSTGRES_URL=

# Route map tiles. Priority: Mapbox > MapTiler > OpenFreeMap (keyless
# fallback, so local dev works without either).
# Mapbox: free tier (50k loads/month, no credit card) at
# https://account.mapbox.com/access-tokens/ — use a public token (pk.*).
NEXT_PUBLIC_MAPBOX_TOKEN=
# MapTiler: free tier (100k loads/month, no credit card) at
# https://www.maptiler.com/ -> Account -> Keys.
NEXT_PUBLIC_MAPTILER_KEY=

# Production values are provisioned automatically by the Supabase Vercel integration
# and injected at deploy time — never copy real production secrets into this file.
