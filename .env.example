# Copy to .env.local for local development (defaults below match `supabase start`'s
# well-known local demo keys — no need to change them for local dev).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
POSTGRES_URL=

# Route map tiles. Free tier (100k loads/month, no credit card) at
# https://www.maptiler.com/ -> Account -> Keys. Falls back to OpenFreeMap
# (no key needed) if unset, so local dev works without one.
NEXT_PUBLIC_MAPTILER_KEY=

# Production values are provisioned automatically by the Supabase Vercel integration
# and injected at deploy time — never copy real production secrets into this file.
